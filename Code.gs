    var c = CacheService.getScriptCache(), m = c.get('bgm:' + name + ':' + bigVer_(name)); if (!m) return null;
    var n = parseInt(m, 10), keys = [], i; for (i = 0; i < n; i++) keys.push('bgc:' + name + ':' + bigVer_(name) + ':' + i);
    var got = {}, j; for (j = 0; j < keys.length; j += 40) { var part = c.getAll(keys.slice(j, j + 40)); for (var k in part) got[k] = part[k]; }
