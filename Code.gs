function ss_() { if (!ss_.c) ss_.c = SpreadsheetApp.openById(SHEET_ID); return ss_.c; }
function sheet_(name) { var sh = ss_().getSheetByName(name); if (!sh) throw new Error('تبويب غير موجود: ' + name); return sh; }
function tz_() { return 'Asia/Riyadh'; }

function norm_(v) {
  if (v instanceof Date) {
    if (v.getFullYear() < 1950) return Utilities.formatDate(v, tz_(), 'HH:mm');
    var hh = Utilities.formatDate(v, tz_(), 'HH:mm');
    return hh === '00:00' ? Utilities.formatDate(v, tz_(), 'yyyy-MM-dd') : Utilities.formatDate(v, tz_(), 'yyyy-MM-dd HH:mm');
  }
  return v === null || v === undefined ? '' : v;
