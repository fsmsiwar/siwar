/* ====================== المصادقة ====================== */

function listLoginUsers() {
  var rows = readTable_(T.EMP).rows;
  /* v4.1: الدخول للمديرين فقط، فلا تظهر أسماء بقية الموظفين في صفحة الدخول */
  return rows.filter(function (r) { return r['الحالة'] === 'نشط' && r['الدور'] === 'مدير'; })
    .map(function (r) { return { code: r['الكود'], name: r['الاسم'] }; });
}

var LONG_DAYS_ = 30;
function pruneTokens_(revokeCode) {
  var props = PropertiesService.getScriptProperties(), all = props.getProperties(), now = Date.now();
  Object.keys(all).forEach(function (k) {
    if (k.indexOf('LT_') !== 0) return;
    try { var o = JSON.parse(all[k]); if (o.exp < now || (revokeCode && o.code === revokeCode)) props.deleteProperty(k); } catch (e) { props.deleteProperty(k); }
  });
}

function login(code, pin, remember) {
  try {
    code = String(code || '').trim(); pin = String(pin || '');
    var s = settingsMap_();
    var maxTry = numS_(s['محاولات_الدخول_القصوى'], 5), lockMin = numS_(s['مدة_القفل_دقائق'], 15);
    var cache = CacheService.getScriptCache();
    if (cache.get('lk:' + code)) return { ok: false, error: 'الحساب مقفل مؤقتاً بسبب محاولات خاطئة. حاول بعد ' + lockMin + ' دقيقة.' };
    var u = findBy_(tbl_(T.EMP).rows, 'الكود', code);
    if (!u || u['الحالة'] !== 'نشط') return { ok: false, error: 'بيانات الدخول غير صحيحة' };
    if (!u['PIN_Hash']) return { ok: false, error: 'لم يُفعَّل حسابك بعد. اطلب من المدير تعيين رقم سري.' };
    var good = safeEq_(hashPin_(code, u['Salt'], pin), u['PIN_Hash']);
    if (!good) {
      var n = parseInt(cache.get('fl:' + code) || '0', 10) + 1;
      cache.put('fl:' + code, String(n), 1800);
      log_({ code: code, name: u['الاسم'] }, 'الدخول', 'محاولة فاشلة', code, '', n, '');
      if (n >= maxTry) { cache.put('lk:' + code, '1', Math.min(lockMin * 60, 21600)); cache.remove('fl:' + code); addAlert_('نظام', 'تم قفل حساب ' + u['الاسم'] + ' بعد محاولات دخول خاطئة', 'تحذير', 'lock:' + code + ':' + todayS_() + ':' + Math.floor(Date.now() / 3600000)); }
      return { ok: false, error: 'بيانات الدخول غير صحيحة' };
    }
    cache.remove('fl:' + code);
    var token = Utilities.getUuid() + Utilities.getUuid();
    var hours = Math.min(numS_(s['مهلة_الجلسة_ساعات'], 6), 6);
    cache.put('s:' + sha_(token), JSON.stringify({ code: code }), hours * 3600);
    if (remember) { pruneTokens_(); PropertiesService.getScriptProperties().setProperty('LT_' + sha_(token), JSON.stringify({ code: code, exp: Date.now() + LONG_DAYS_ * 86400000 })); }
    return { ok: true, token: token, mustChange: u['يجب_تغيير_PIN'] === 'نعم', user: publicUser_(u) };
  } catch (e) { return { ok: false, error: String(e.message || e) }; }
}

function auth_(token) {
  if (!token) throw new Error('انتهت الجلسة، سجّل الدخول من جديد');
  var key = sha_(token), cache = CacheService.getScriptCache(), j = cache.get('s:' + key), code = null;
  if (j) code = JSON.parse(j).code;
  else {
    var props = PropertiesService.getScriptProperties(), lt = props.getProperty('LT_' + key);
    if (lt) {
      try { var o = JSON.parse(lt); if (o.exp > Date.now()) { code = o.code; cache.put('s:' + key, JSON.stringify({ code: code }), 21600); } else props.deleteProperty('LT_' + key); } catch (e) { props.deleteProperty('LT_' + key); }
    }
  }
  if (!code) throw new Error('انتهت الجلسة، سجّل الدخول من جديد');
  var u = findBy_(tbl_(T.EMP).rows, 'الكود', code);
  if (!u || u['الحالة'] !== 'نشط') throw new Error('الحساب غير فعّال');
  return u;
}

function publicUser_(u) {
  return { code: u['الكود'], name: u['الاسم'], role: u['الدور'], dept: u['القسم'] };
}

function hashPin_(code, salt, pin) {
  var pepper = PropertiesService.getScriptProperties().getProperty('PEPPER');
  if (!pepper) throw new Error('النظام غير مثبّت. شغّل installSystem من المحرر.');
  var sig = Utilities.computeHmacSha256Signature(code + '|' + salt + '|' + pin, pepper);
  return sig.map(function (b) { return ('0' + (b & 0xff).toString(16)).slice(-2); }).join('');
}

function sha_(s) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, s)
    .map(function (b) { return ('0' + (b & 0xff).toString(16)).slice(-2); }).join('');
}

function safeEq_(a, b) {
  a = String(a); b = String(b); if (a.length !== b.length) return false;
  var d = 0; for (var i = 0; i < a.length; i++) d |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return d === 0;
}

function setPin_(userRow, pin, mustChange) {
  var salt = Utilities.getUuid().replace(/-/g, '');
  updateRowCells_(T.EMP, userRow.__row, {
    'PIN_Hash': hashPin_(userRow['الكود'], salt, pin), 'Salt': salt, 'يجب_تغيير_PIN': mustChange ? 'نعم' : 'لا'
  });
  bust_(T.EMP);
  try { pruneTokens_(userRow['الكود']); } catch (e) { }
}

/* ====================== الموزّع الرئيسي ====================== */

function api(token, action, p) {
  var tA = Date.now(); PERF_ = [];
  try {
    if (action === 'logout') {
      var k = sha_(String(token || ''));
      CacheService.getScriptCache().remove('s:' + k); PropertiesService.getScriptProperties().deleteProperty('LT_' + k);
      return { ok: true, data: {} };
    }
    var u = auth_(token); api.pre = Date.now() - tA;
    if (action === 'batch') return { ok: true, data: batchRun_(u, p), ms: Date.now() - tA, rt: perfTop_() };
    var h = ACTIONS_[action];
    if (!h) throw new Error('إجراء غير معروف: ' + action);
    if (h.perm && !can_(u, h.perm)) throw new Error('ليست لديك صلاحية لهذا الإجراء');
    var t0 = Date.now(), d0 = h.fn(u, p || {});
    return { ok: true, data: d0, ms: Date.now() - t0 + (api.pre || 0), rt: perfTop_() };
  } catch (e) {
    return { ok: false, error: String(e.message || e) };
  }
}

function perfTop_() { return PERF_.slice().sort(function (a, b) { return (+b.split(':')[2]) - (+a.split(':')[2]); }).slice(0, 4).join(' | '); }

