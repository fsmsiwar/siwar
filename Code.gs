    var ks = Object.keys(obj); for (i = 0; i < ks.length; i += 40) { var sub = {}; ks.slice(i, i + 40).forEach(function (k) { sub[k] = obj[k]; }); c.putAll(sub, BIGTTL_); }
    c.put('bgm:' + name + ':' + ver, String(n), BIGTTL_);
