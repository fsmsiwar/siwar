/* ====================== الإجازات ====================== */

function leaveDays_(emp, from, to, method) {
  if (to < from) throw new Error('تاريخ النهاية قبل البداية');
  var n = dayDiff_(from, to) + 1;
  if (method === 'عمل' && emp && emp['يوم_الراحة']) {
    var c = 0; for (var i = 0; i < n; i++) if (weekday_(addDays_(from, i)) !== emp['يوم_الراحة']) c++;
    return c;
  }
  return n;
}

function leavesList_(u, p) {
  var emps = tbl_(T.EMP).rows, leaves = readTable_(T.LEAVE).rows, today = todayS_();
  var isMgr = can_(u, 'اعتماد_إجازة');
  leaves = leaves.filter(function (l) { return isMgr || l['كود_الموظف'] === u['الكود']; });
  leaves.forEach(function (l) { l.phase = l['الاعتماد'] !== 'معتمدة' ? l['الاعتماد'] : (String(l['إلى']) < today ? 'منتهية' : String(l['من']) > today ? 'مجدولة' : 'جارية'); });
  leaves.sort(function (a, b) { return String(b['من']).localeCompare(String(a['من'])); });
  var bal = emps.filter(function (e) { return e['الدور'] !== 'مدير' && e['الرصيد_السنوي'] !== '' && (isMgr || e['الكود'] === u['الكود']); }).map(function (e) {
    var used = 0, sched = 0;
    leaves.forEach(function (l) {
      if (l['كود_الموظف'] !== e['الكود'] || l['النوع'] !== 'سنوية' || l['الاعتماد'] !== 'معتمدة') return;
      if (String(l['إلى']) < today) used += num_(l['الأيام']); else sched += num_(l['الأيام']);
    });
    return { code: e['الكود'], name: e['الاسم'], dept: e['القسم'], total: num_(e['الرصيد_السنوي']), used: used, scheduled: sched, remaining: num_(e['الرصيد_السنوي']) - used - sched };
  });
  return { leaves: leaves, balances: bal };
}

function leaveRequest_(u, p) {
  return withLock_(function () {
    var isMgr = can_(u, 'اعتماد_إجازة'), code = isMgr && p.emp ? p.emp : u['الكود'];
    var emp = findBy_(tbl_(T.EMP).rows, 'الكود', code); if (!emp) throw new Error('الموظف غير موجود');
    if (!p.from || !p.to) throw new Error('حدد تاريخ البداية والنهاية');
