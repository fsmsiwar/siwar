/* ====================== المهام ====================== */

function ensureTasks_(date) {
  return withLock_(function () {
    var tpl = tbl_(T.TASK).rows.filter(function (r) { return r['فعال'] !== 'لا'; });
    var ex = readTable_(T.TEXEC).rows, keys = {};
    ex.forEach(function (r) { keys[r['مفتاح_فريد']] = true; });
    var wd = weekday_(date), add = [];
    tpl.forEach(function (t) {
      var days = String(t['الأيام'] || '');
      var applies = t['التكرار'] === 'يومي' || days.indexOf(wd) >= 0;
      if (!applies) return;
      var key = date + '|' + t['الرقم'];
      if (keys[key]) return;
      add.push({ 'التاريخ': date, 'رقم_المهمة': t['الرقم'], 'العنوان': t['العنوان'], 'القسم': t['القسم_المسؤول'], 'الوقت_المستهدف': t['الوقت'], 'الحالة': 'قادمة', 'نفّذها': '', 'وقت_التنفيذ': '', 'ملاحظة': '', 'مفتاح_فريد': key });
    });
    appendRows_(T.TEXEC, add);
    return add.length;
  });
}

function taskSweep_() {
  var today = todayS_(), now = hhmm_(), tpl = indexBy_(tbl_(T.TASK).rows, 'الرقم'), s = settingsMap_();
  var lead = numS_(s['دقائق_تذكير_مسبق'], 15);
  readTable_(T.TEXEC).rows.forEach(function (r) {
    if (r['الحالة'] !== 'قادمة') return;
    var t = tpl[String(r['رقم_المهمة'])], grace = t ? num_(t['مدة_السماح_دقائق'], 0) : 0;
    var due = dtMs_(String(r['التاريخ']), r['الوقت_المستهدف'] || '23:59'), nowMs = Date.now();
    if (String(r['التاريخ']) < today || nowMs > due + grace * 60000) {
      updateRowCells_(T.TEXEC, r.__row, { 'الحالة': 'متأخرة' });
      addAlert_('مهمة', 'مهمة متأخرة: ' + r['العنوان'] + ' (' + r['القسم'] + ')', t && t['إلزامي'] === 'نعم' ? 'عاجل' : 'تحذير', 'task:late:' + r['مفتاح_فريد']);
    } else if (String(r['التاريخ']) === today && nowMs >= due - lead * 60000) {
      addAlert_('مهمة', 'تذكير: ' + r['العنوان'] + ' الساعة ' + r['الوقت_المستهدف'], 'معلومة', 'task:soon:' + r['مفتاح_فريد']);
    }
  });
}

function tasksToday_(u, p) {
  var date = p.date || todayS_();
  if (date === todayS_()) { ensureTasks_(date); taskSweep_(); }
  var rows = readTable_(T.TEXEC).rows.filter(function (r) { return String(r['التاريخ']) === date; });
  rows.sort(function (a, b) { return String(a['الوقت_المستهدف']).localeCompare(String(b['الوقت_المستهدف'])); });
  return { date: date, rows: rows };
}

function taskComplete_(u, p) {
