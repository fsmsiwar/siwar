    var late = r['الحالة'] === 'متأخرة';
    updateRowCells_(T.TEXEC, r.__row, { 'الحالة': 'منفذة', 'نفّذها': u['الاسم'], 'وقت_التنفيذ': hhmm_(), 'ملاحظة': (p.note || '') + (late ? ' (نُفذت متأخرة)' : '') });
