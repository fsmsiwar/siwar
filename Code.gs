  var head = sh.getRange(1, 1, 1, lc).getValues()[0].map(String);
  var start = lastDataRow_(sh) + 1;
  if (start + objs.length - 1 > sh.getMaxRows()) sh.insertRowsAfter(sh.getMaxRows(), objs.length + 100);
  var rng = sh.getRange(start, 1, objs.length, lc);
  var fx = rng.getFormulas(), vv = rng.getValues(), out = [];
  for (var i = 0; i < objs.length; i++) {
    var row = [];
    for (var j = 0; j < lc; j++) {
      if (Object.prototype.hasOwnProperty.call(objs[i], head[j])) row.push(objs[i][head[j]]);
      else row.push(fx[i][j] ? fx[i][j] : vv[i][j]);
    }
    out.push(row);
  }
  rng.setValues(out);
  bust_(name);
}

function updateRowCells_(name, rowNum, patch) {
  var sh = sheet_(name), lc = sh.getLastColumn();
  var head = sh.getRange(1, 1, 1, lc).getValues()[0].map(String);
  Object.keys(patch).forEach(function (k) {
    var c = head.indexOf(k); if (c < 0) throw new Error('عمود غير موجود: ' + k);
    sh.getRange(rowNum, c + 1).setValue(patch[k]);
  });
  bust_(name);
}

/** يحدّث عموداً كاملاً للصفوف المطابقة للشرط بعملية كتابة واحدة. */
function updateWhere_(name, filterFn, patch) {
  var t = readTable_(name), sh = sheet_(name), n = 0;
  var rows = t.rows.filter(filterFn); if (!rows.length) return 0;
  var lr = sh.getLastRow();
  Object.keys(patch).forEach(function (k) {
    var c = t.head.indexOf(k) + 1; if (c < 1) throw new Error('عمود غير موجود: ' + k);
    var rng = sh.getRange(2, c, lr - 1, 1), vals = rng.getValues();
    rows.forEach(function (r) { vals[r.__row - 2][0] = patch[k]; });
    rng.setValues(vals);
  });
  bust_(name);
  return rows.length;
}

function findBy_(rows, key, val) {
  for (var i = 0; i < rows.length; i++) if (String(rows[i][key]) === String(val)) return rows[i];
  return null;
}
function indexBy_(rows, key) { var o = {}; rows.forEach(function (r) { o[String(r[key])] = r; }); return o; }

function settingsMap_() {
  var o = {}; tbl_(T.SET).rows.forEach(function (r) { o[r['المفتاح']] = r['القيمة']; }); return o;
}
function numS_(v, d) { var n = parseFloat(v); return isNaN(n) ? d : n; }
function num_(v, d) { var n = parseFloat(v); return isNaN(n) ? (d === undefined ? 0 : d) : n; }

function listsMap_() {
  var sh = sheet_(T.LISTS), lr = sh.getLastRow(), lc = sh.getLastColumn(), o = {};
  var vals = sh.getRange(1, 1, lr, lc).getValues();
  for (var j = 0; j < lc; j++) {
    var h = String(vals[0][j]); if (!h) continue; o[h] = [];
    for (var i = 1; i < lr; i++) if (vals[i][j] !== '') o[h].push(String(vals[i][j]));
  }
  return o;
}

/* ====================== أدوات التاريخ والقفل ====================== */

function todayS_() { return Utilities.formatDate(new Date(), tz_(), 'yyyy-MM-dd'); }
function nowS_() { return Utilities.formatDate(new Date(), tz_(), 'yyyy-MM-dd HH:mm'); }
function hhmm_() { return Utilities.formatDate(new Date(), tz_(), 'HH:mm'); }
function addDays_(ds, n) {
  var p = ds.split('-'); var d = new Date(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10) + n, 12, 0, 0);
  return Utilities.formatDate(d, tz_(), 'yyyy-MM-dd');
}
function dayDiff_(a, b) {
  var pa = a.split('-'), pb = b.split('-');
  return Math.round((Date.UTC(+pb[0], +pb[1] - 1, +pb[2]) - Date.UTC(+pa[0], +pa[1] - 1, +pa[2])) / 86400000);
}
function weekday_(ds) { var p = ds.split('-'); return DAYS_AR_[new Date(+p[0], +p[1] - 1, +p[2], 12).getDay()]; }
function dtMs_(ds, hm) { var p = ds.split('-'), t = String(hm || '12:00').split(':'); return new Date(+p[0], +p[1] - 1, +p[2], +t[0] || 0, +t[1] || 0).getTime(); }
function pad_(n, w) { var s = String(n); while (s.length < w) s = '0' + s; return s; }

var lockDepth_ = 0;
function withLock_(fn, ms) {
  if (lockDepth_ > 0) return fn();
  var lock = LockService.getScriptLock();
  lock.waitLock(ms || 25000);
  lockDepth_++;
  try { var r = fn(); SpreadsheetApp.flush(); return r; }
  finally { lockDepth_--; lock.releaseLock(); }
}

function nextCounter_(key) {
  var props = PropertiesService.getScriptProperties();
  var n = parseInt(props.getProperty('CNT_' + key) || '0', 10) + 1;
  props.setProperty('CNT_' + key, String(n));
  return n;
}
/** يضمن ألا ينزل العداد عن أعلى معرّف موجود (مفيد بعد الإضافة اليدوية في الشيت). */
function nextId_(key, prefix, rows, col, width) {
  var max = 0;
  rows.forEach(function (r) { var m = String(r[col]).match(/(\d+)$/); if (m) max = Math.max(max, parseInt(m[1], 10)); });
  var props = PropertiesService.getScriptProperties();
  var cur = Math.max(max, parseInt(props.getProperty('CNT_' + key) || '0', 10)) + 1;
  props.setProperty('CNT_' + key, String(cur));
  return prefix + pad_(cur, width || 3);
}

/* ====================== الصلاحيات والسجل ====================== */

function can_(u, perm) {
  var role = u['الدور'];
  if (role === 'مدير' && (perm === 'إدارة_الإعدادات' || perm === 'إدارة_الموظفين')) return true;
  var row = findBy_(tbl_(T.PERM).rows, 'الصلاحية', perm);
  return !!row && row[role === 'مدير' ? 'مدير' : role === 'مشرف' ? 'مشرف' : 'موظف'] === 'نعم';
}
function permsOf_(u) {
  var o = {}; tbl_(T.PERM).rows.forEach(function (r) { o[r['الصلاحية']] = can_(u, r['الصلاحية']); }); return o;
}

function log_(u, module, op, rec, before, after, reason) {
  try {
    appendRows_(T.LOG, [{
      'الوقت': nowS_(), 'المستخدم': u ? (u.name || u['الاسم'] || '') : '', 'الوحدة': module, 'العملية': op,
      'السجل': rec, 'قبل': before === undefined ? '' : String(before), 'بعد': after === undefined ? '' : String(after), 'السبب': reason || ''
    }]);
  } catch (e) { }
}

/* ====================== الطاقة الاستيعابية ====================== */

function activeCapRows_() { return tbl_(T.CAP).rows.filter(function (r) { return r['فعال'] !== 'لا'; }); }

/** الكميات الملتزمة: خريطة 'تاريخ|فئة' إلى وحدات الطاقة. */
function committedMap_() {
  var m = {};
  readTable_(T.ITEM).rows.forEach(function (r) {
    if (DEAD_STATUS_.indexOf(r['حالة_الفاتورة']) >= 0) return;
    var k = r['تاريخ_الاستلام'] + '|' + r['الفئة'];
    m[k] = (m[k] || 0) + num_(r['وحدات_الطاقة']);
  });
  return m;
}

function capLimit_(date, cat, s) {
  var capRow = findBy_(activeCapRows_(), 'الفئة', cat);
  var limit = capRow && capRow['الحد_اليومي'] !== '' ? num_(capRow['الحد_اليومي']) : null;
  var warn = capRow && capRow['تحذير_%'] !== '' ? num_(capRow['تحذير_%']) : numS_(s['نسبة_تحذير_الطاقة'], 80);
  var stop = capRow && capRow['إيقاف_%'] !== '' ? num_(capRow['إيقاف_%']) : numS_(s['نسبة_إيقاف_الطلبات'], 100);
  var season = null, specific = false;
  tbl_(T.SEASON).rows.forEach(function (z) {
    if (z['فعال'] === 'لا' || z['الحد_اليومي_البديل'] === '') return;
    if (String(z['من']) > date || String(z['إلى']) < date) return;
    var zc = String(z['الفئة'] || '');
    var isAll = (zc === '' || zc === 'الكل');
    if (!isAll && zc !== cat) return;
    if (!specific || !isAll) { season = z; specific = !isAll; }
  });
  if (season) limit = num_(season['الحد_اليومي_البديل']);
  return { limit: limit, warn: warn, stop: stop, season: season ? season['الاسم'] : '' };
}

function capCell_(date, cat, committed, add, s) {
  var L = capLimit_(date, cat, s), units = (committed[date + '|' + cat] || 0) + (add || 0);
  var pct = L.limit ? units / L.limit * 100 : null;
  var status = pct === null ? 'بلا حد' : pct >= L.stop ? 'إيقاف' : pct >= L.warn ? 'تحذير' : 'متاح';
  return { date: date, cat: cat, units: units, limit: L.limit, pct: pct === null ? null : Math.round(pct * 10) / 10, status: status, warn: L.warn, stop: L.stop, season: L.season };
}

function capacityMatrix_(from, days) {
  var s = settingsMap_(), committed = committedMap_(), cats = activeCapRows_().map(function (r) { return r['الفئة']; });
  var out = [];
  for (var i = 0; i < Math.min(days, 60); i++) {
    var d = addDays_(from, i), cells = cats.map(function (c) { return capCell_(d, c, committed, 0, s); });
    var worst = 'متاح', maxPct = null;
    cells.forEach(function (c) {
      if (c.pct !== null && (maxPct === null || c.pct > maxPct)) maxPct = c.pct;
      if (c.status === 'إيقاف') worst = 'إيقاف'; else if (c.status === 'تحذير' && worst !== 'إيقاف') worst = 'تحذير';
    });
    if (maxPct === null) worst = 'بلا حد';
    out.push({ date: d, weekday: weekday_(d), cells: cells, maxPct: maxPct, status: worst });
  }
  return out;
}

/* ====================== الحجوزات ====================== */

function bookingCreate_(u, p) {
  return withLock_(function () {
    var s = settingsMap_(), items = p.items || [];
    if (!items.length) throw new Error('أضف بنداً واحداً على الأقل');
    if (!p.pickupDate) throw new Error('تاريخ الاستلام مطلوب');
    if (p.pickupDate < todayS_()) throw new Error('تاريخ الاستلام في الماضي');
    var phone = normPhone_(p.customerPhone);
    if (!phone) throw new Error('جوال العميل مطلوب');
    if (!/^05\d{8}$/.test(phone) && !/^\d{9,15}$/.test(phone)) throw new Error('رقم الجوال غير صحيح. اكتبه بالشكل 05xxxxxxxx');
    var invT = readTable_(T.INV);
    if (p.requestId) {
      var dup = findBy_(invT.rows, 'معرّف_الطلب', p.requestId);
      if (dup) return { duplicate: true, invoiceNo: dup['رقم_الفاتورة'] };
    }
    var no = String(p.invoiceNo || '').trim();
    if (no) { if (findBy_(invT.rows, 'رقم_الفاتورة', no)) throw new Error('رقم الفاتورة مستخدم مسبقاً'); }
    else no = String(s['بادئة_رقم_الحجز'] || 'SW-') + pad_(nextCounter_('INV'), 5);

    var prods = indexBy_(tbl_(T.PROD).rows, 'الكود'), lines = [], add = {}, total = 0, maxPrep = 0, prepName = '';
    items.forEach(function (it, i) {
      var pr = prods[String(it.code)];
      if (!pr || pr['فعال'] === 'لا') throw new Error('منتج غير معروف أو غير فعّال: ' + it.code);
      var qty = num_(it.qty); if (!(qty > 0)) throw new Error('كمية غير صحيحة للمنتج ' + pr['الاسم']);
      var price = it.price !== undefined && it.price !== '' ? num_(it.price) : num_(pr['السعر']);
      var coef = pr['معامل_الطاقة'] === '' ? 1 : num_(pr['معامل_الطاقة'], 1);
      var date = it.date || p.pickupDate, units = qty * coef, k = date + '|' + pr['الفئة'];
      add[k] = (add[k] || 0) + units;
      var prep = num_(pr['ساعات_التحضير_المسبق']); if (prep > maxPrep) { maxPrep = prep; prepName = pr['الاسم']; }
      if (price < 0) throw new Error('سعر سالب للمنتج ' + pr['الاسم']);
      total += r2_(qty * price);
      lines.push({
        'رقم_الفاتورة': no, 'السطر': i + 1, 'كود_المنتج': pr['الكود'], 'اسم_المنتج': pr['الاسم'], 'الفئة': pr['الفئة'],
        'الكمية': qty, 'معامل_الطاقة': coef, 'وحدات_الطاقة': units, 'السعر': price, 'الإجمالي': r2_(qty * price),
        'تاريخ_الاستلام': date, 'حالة_الفاتورة': '', 'حالة_البند': 'معلّق', 'ملاحظات': it.notes || ''
      });
    });
    var fee = num_(p.deliveryFee); if (fee < 0) throw new Error('رسوم التوصيل لا تكون سالبة'); total = r2_(total + fee);

    var committed = committedMap_(), blocks = [], warnings = [], touched = [];
    Object.keys(add).forEach(function (k) {
      var parts = k.split('|'), c = capCell_(parts[0], parts[1], committed, add[k], s);
      touched.push(c);
      if (c.limit === null) warnings.push('لا يوجد حد طاقة محدد للفئة «' + parts[1] + '»');
      else if (c.status === 'إيقاف') blocks.push({ type: 'CAPACITY', msg: 'الطاقة ستصل ' + c.pct + '% للفئة «' + parts[1] + '» بتاريخ ' + parts[0] + ' (الحد ' + c.limit + ')' });
      else if (c.status === 'تحذير') warnings.push('الفئة «' + parts[1] + '» ستصل ' + c.pct + '% بتاريخ ' + parts[0]);
    });
    if (maxPrep > 0) {
      var hrs = (dtMs_(p.pickupDate, p.pickupTime) - Date.now()) / 3600000;
      if (hrs < maxPrep) blocks.push({ type: 'PREP', msg: '«' + prepName + '» تحتاج تحضيراً مسبقاً ' + maxPrep + ' ساعة والمتبقي ' + Math.max(0, Math.round(hrs)) + ' ساعة' });
    }
    if (blocks.length) {
      if (!p.override) return { blocked: true, blocks: blocks, warnings: warnings, canOverride: can_(u, 'تجاوز_الطاقة') };
      if (!can_(u, 'تجاوز_الطاقة')) throw new Error('ليست لديك صلاحية تجاوز الطاقة');
      log_(u, 'الحجوزات', 'تجاوز طاقة', no, '', blocks.map(function (b) { return b.msg; }).join(' | '), p.overrideReason || '');
    }

    var status = p.status === 'معلّق' ? 'معلّق' : 'مؤكدة';
    lines.forEach(function (l) { l['حالة_الفاتورة'] = status; });
    var exp = status === 'معلّق' ? Utilities.formatDate(new Date(Date.now() + numS_(s['مهلة_الحجز_المعلق_ساعات'], 24) * 3600000), tz_(), 'yyyy-MM-dd HH:mm') : '';
    var dep = p.deposit && num_(p.deposit.amount) > 0 ? p.deposit : null;
    var paid = dep ? r2_(num_(dep.amount)) : 0;
    if (paid > total + 0.005) throw new Error('العربون (' + paid + ') أكبر من إجمالي الفاتورة (' + total + ')');
    appendRows_(T.INV, [{
      'رقم_الفاتورة': no, 'تاريخ_الحجز': todayS_(), 'وقت_الحجز': hhmm_(), 'كود_الكاشير': u['الكود'], 'جوال_العميل': phone,
      'اسم_العميل': p.customerName || '', 'نوع_الطلب': p.type === 'توصيل' ? 'توصيل' : 'استلام', 'تاريخ_الاستلام': p.pickupDate,
      'وقت_الاستلام': p.pickupTime || '', 'الحالة': status, 'الإجمالي': total, 'المدفوع': paid, 'المتبقي': r2_(total - paid),
      'عنوان_التوصيل': p.deliveryAddress || '', 'رسوم_التوصيل': fee, 'سبب_الإلغاء': '', 'ينتهي_الحجز_في': exp,
      'ملاحظات': p.notes || '', 'معرّف_الطلب': p.requestId || ''
    }]);
    appendRows_(T.ITEM, lines);
    upsertCustomer_(phone, p.customerName);
    if (dep) addPaymentRow_(u, no, dep.method || 'كاش', num_(dep.amount), 'عربون', '');
    touched.forEach(function (c) { capAlert_(c, no); });
    log_(u, 'الحجوزات', 'إنشاء', no, '', total, '');
    return { invoiceNo: no, total: total, paid: paid, remaining: total - paid, warnings: warnings };
  });
}

function capAlert_(c, ref) {
  var s = settingsMap_(), cell = capCell_(c.date, c.cat, committedMap_(), 0, s);
  if (cell.status === 'إيقاف') addAlert_('طاقة', 'أوقف أخذ الطلبات للفئة «' + c.cat + '» بتاريخ ' + c.date + ' — وصلت ' + cell.pct + '%', 'عاجل', 'cap:stop:' + c.date + ':' + c.cat);
  else if (cell.status === 'تحذير') addAlert_('طاقة', 'اقتراب من الطاقة القصوى للفئة «' + c.cat + '» بتاريخ ' + c.date + ' — ' + cell.pct + '%', 'تحذير', 'cap:warn:' + c.date + ':' + c.cat);
}

/** يوحّد صيغة الجوال: أرقام لاتينية فقط، و+966/00966/5xxxxxxxx تتحول إلى 05xxxxxxxx. أي رقم آخر يُترك أرقاماً فقط. */
function normPhone_(v) {
  var s = String(v === null || v === undefined ? '' : v).replace(/[٠-٩]/g, function (d) { return String(d.charCodeAt(0) - 1632); }).replace(/[۰-۹]/g, function (d) { return String(d.charCodeAt(0) - 1776); }).replace(/[\s\-().]/g, '');
  if (!s) return '';
  s = s.replace(/^\+/, '').replace(/^00/, '');
  if (/^9665\d{8}$/.test(s)) s = '0' + s.slice(3);
  else if (/^5\d{8}$/.test(s)) s = '0' + s;
  return s;
}
function upsertCustomer_(phone, name) {
  var t = readTable_(T.CUST), c = findBy_(t.rows, 'الجوال', phone);
  if (!c) appendRows_(T.CUST, [{ 'الجوال': phone, 'الاسم': name || '', 'ملاحظات': '', 'تاريخ_الإضافة': todayS_() }]);
  else if (name && !c['الاسم']) updateRowCells_(T.CUST, c.__row, { 'الاسم': name });
}

function bookingList_(u, p) {
  var rows = readTable_(T.INV).rows, q = String(p.q || '').trim();
  rows = rows.filter(function (r) {
    if (p.status && r['الحالة'] !== p.status) return false;
    if (p.from && String(r['تاريخ_الاستلام']) < p.from) return false;
    if (p.to && String(r['تاريخ_الاستلام']) > p.to) return false;
    if (q && (String(r['رقم_الفاتورة']) + ' ' + r['جوال_العميل'] + ' ' + r['اسم_العميل']).indexOf(q) < 0) return false;
    return true;
  });
  rows.sort(function (a, b) { return String(a['تاريخ_الاستلام']).localeCompare(String(b['تاريخ_الاستلام'])) || String(a['وقت_الاستلام']).localeCompare(String(b['وقت_الاستلام'])); });
  if (p.desc) rows.reverse();
  return rows.slice(0, 300);
}

function bookingGet_(u, p) {
  var no = String(p.invoiceNo), inv = findBy_(readTable_(T.INV).rows, 'رقم_الفاتورة', no);
  if (!inv) throw new Error('الحجز غير موجود');
  var f = function (r) { return String(r['رقم_الفاتورة']) === no; };
  return { invoice: inv, items: readTable_(T.ITEM).rows.filter(f), payments: readTable_(T.PAY).rows.filter(f), returns: readTable_(T.RET).rows.filter(f) };
}

function recalcPaid_(no) {
  var paid = 0;
  readTable_(T.PAY).rows.forEach(function (r) {
    if (String(r['رقم_الفاتورة']) !== String(no)) return;
    paid += r['النوع'] === 'استرداد' ? -num_(r['المبلغ']) : num_(r['المبلغ']);
  });
  var inv = findBy_(readTable_(T.INV).rows, 'رقم_الفاتورة', no);
  updateRowCells_(T.INV, inv.__row, { 'المدفوع': paid, 'المتبقي': num_(inv['الإجمالي']) - paid });
  return { paid: paid, remaining: num_(inv['الإجمالي']) - paid };
}

function addPaymentRow_(u, no, method, amount, type, note) {
  var rows = readTable_(T.PAY).rows;
  var id = nextId_('PAY', 'P', rows, 'رقم_الدفعة', 5);
  appendRows_(T.PAY, [{ 'رقم_الدفعة': id, 'رقم_الفاتورة': no, 'التاريخ': todayS_(), 'الوقت': hhmm_(), 'الطريقة': method, 'المبلغ': amount, 'النوع': type, 'كود_الموظف': u['الكود'], 'ملاحظات': note || '' }]);
  return recalcPaid_(no);
}

function bookingPay_(u, p) {
  return withLock_(function () {
    var amount = num_(p.amount); if (!(amount > 0)) throw new Error('المبلغ غير صحيح');
    if (['كاش', 'شبكة', 'تحويل'].indexOf(p.method) < 0) throw new Error('طريقة الدفع غير صحيحة');
    var inv = findBy_(readTable_(T.INV).rows, 'رقم_الفاتورة', p.invoiceNo); if (!inv) throw new Error('الحجز غير موجود');
    if (inv['الحالة'] === 'ملغاة') throw new Error('الحجز ملغي');
    if (amount > num_(inv['المتبقي']) + 0.001) throw new Error('المبلغ أكبر من المتبقي (' + inv['المتبقي'] + ')');
    var r = addPaymentRow_(u, p.invoiceNo, p.method, amount, p.type === 'عربون' ? 'عربون' : 'سداد', p.note);
    log_(u, 'الدفعات', 'دفعة', p.invoiceNo, '', amount + ' ' + p.method, '');
    return r;
  });
}

function bookingStatus_(u, p) {
  return withLock_(function () {
    var inv = findBy_(readTable_(T.INV).rows, 'رقم_الفاتورة', p.invoiceNo); if (!inv) throw new Error('الحجز غير موجود');
    var to = p.status, from = inv['الحالة'];
    if (['معلّق', 'مؤكدة', 'مسلّمة', 'ملغاة'].indexOf(to) < 0) throw new Error('حالة غير صحيحة');
    if (to === from) return { status: to };
    if (to === 'ملغاة') {
      if (!can_(u, 'إلغاء_حجز')) throw new Error('ليست لديك صلاحية الإلغاء');
      if (!p.reason) throw new Error('سبب الإلغاء مطلوب');
    } else if (from === 'مؤكدة' || from === 'مسلّمة' || from === 'ملغاة') {
      if (!can_(u, 'تعديل_حجز_مؤكد')) throw new Error('ليست لديك صلاحية تعديل حجز مؤكد');
    }
    if (to === 'مسلّمة' && num_(inv['المتبقي']) > 0.001 && !(p.allowUnpaid && can_(u, 'تعديل_حجز_مؤكد'))) throw new Error('يوجد متبقي ' + inv['المتبقي'] + ' — سدّده قبل التسليم');
    if (from === 'ملغاة' || from === 'منتهي') {
      // إعادة التفعيل تحجز الطاقة من جديد: نفحصها
      var s = settingsMap_(), committed = committedMap_(), bad = [];
      var add = {};
      readTable_(T.ITEM).rows.forEach(function (r) { if (String(r['رقم_الفاتورة']) === String(p.invoiceNo)) { var k = r['تاريخ_الاستلام'] + '|' + r['الفئة']; add[k] = (add[k] || 0) + num_(r['وحدات_الطاقة']); } });
      Object.keys(add).forEach(function (k) { var pr = k.split('|'), c = capCell_(pr[0], pr[1], committed, add[k], s); if (c.status === 'إيقاف') bad.push(pr[1] + ' ' + pr[0]); });
      if (bad.length && !(p.override && can_(u, 'تجاوز_الطاقة'))) throw new Error('إعادة التفعيل تتجاوز الطاقة: ' + bad.join('، '));
    }
    updateRowCells_(T.INV, inv.__row, { 'الحالة': to, 'سبب_الإلغاء': to === 'ملغاة' ? p.reason : inv['سبب_الإلغاء'], 'ينتهي_الحجز_في': to === 'معلّق' ? inv['ينتهي_الحجز_في'] : '' });
    var patch = { 'حالة_الفاتورة': to }; if (to === 'مسلّمة') patch['حالة_البند'] = 'مسلّم';
    updateWhere_(T.ITEM, function (r) { return String(r['رقم_الفاتورة']) === String(p.invoiceNo); }, patch);
    log_(u, 'الحجوزات', 'تغيير حالة', p.invoiceNo, from, to, p.reason || '');
    return { status: to, hasPaid: num_(inv['المدفوع']) > 0 && to === 'ملغاة' };
  });
}

