    expireBookings_(); ensureTasks_(todayS_()); taskSweep_(); capAlertsSweep_(); cashReminder_(); shelfSweep_(); issuesSweep_(); tasteReminder_(); chkCycle_(); try { cxSweep_(); } catch (e) { } try { seasonSweep_(); } catch (e) { } emailUrgent_();
    updateWhere_(T.SET, function (r) { return r['المفتاح'] === 'آخر_تشغيل_ناجح'; }, { 'القيمة': nowS_() });
    bust_(T.SET);
