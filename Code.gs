function styleHeader_(sh, n) {
  sh.getRange(1, 1, 1, n).setBackground('#4e342e').setFontColor('#ffffff').setFontWeight('bold').setHorizontalAlignment('center');
  sh.setFrozenRows(1);
}

/** يضمن وجود كل التبويبات والأعمدة والافتراضيات. يضيف فقط ولا يحذف. يعيد وصف ما أُضيف. */
function ensureSchema_() {
  var ss = ss_(), rep = [];
  Object.keys(SCHEMA_).forEach(function (name) {
    var want = SCHEMA_[name], sh = ss.getSheetByName(name);
    if (!sh) {
      sh = ss.insertSheet(name); sh.setRightToLeft(true);
      if (want.length) { sh.getRange(1, 1, 1, want.length).setValues([want]); styleHeader_(sh, want.length); }
      rep.push('تبويب جديد: ' + name);
      return;
    }
    if (!want.length) return;
    var lc = Math.max(sh.getLastColumn(), 1), have = sh.getRange(1, 1, 1, lc).getValues()[0].map(String), added = [];
    want.forEach(function (h) {
      if (have.indexOf(h) < 0) {
        var c = sh.getLastColumn() + 1; sh.getRange(1, c).setValue(h);
        sh.getRange(1, c).setBackground('#4e342e').setFontColor('#ffffff').setFontWeight('bold').setHorizontalAlignment('center');
        have.push(h); added.push(h);
      }
    });
    if (added.length) rep.push('أعمدة جديدة في ' + name + ': ' + added.join('، '));
  });
  // الإعدادات الناقصة
  var sets = readTable_(T.SET).rows, have = {}; sets.forEach(function (r) { have[r['المفتاح']] = true; });
  var addS = DEFAULT_SETTINGS_.filter(function (d) { return !have[d[0]]; }).map(function (d) { return { 'المفتاح': d[0], 'القيمة': d[1], 'الوصف': d[2], 'النوع': d[3], 'المجموعة': d[4] }; });
  if (addS.length) { appendRows_(T.SET, addS); rep.push('إعدادات جديدة: ' + addS.map(function (x) { return x['المفتاح']; }).join('، ')); }
  // الصلاحيات الناقصة
  var perms = readTable_(T.PERM).rows, hp = {}; perms.forEach(function (r) { hp[r['الصلاحية']] = true; });
  var addP = DEFAULT_PERMS_.filter(function (d) { return !hp[d[0]]; }).map(function (d) { return { 'الصلاحية': d[0], 'موظف': d[1], 'مشرف': d[2], 'مدير': d[3] }; });
  if (addP.length) { appendRows_(T.PERM, addP); rep.push('صلاحيات جديدة: ' + addP.map(function (x) { return x['الصلاحية']; }).join('، ')); }
  // القوائم الناقصة (عمود جديد فقط، لا تُلمس القوائم الموجودة)
  var ls = ss.getSheetByName(T.LISTS), lcl = Math.max(ls.getLastColumn(), 1), lh = ls.getRange(1, 1, 1, lcl).getValues()[0].map(String), addedL = [];
  Object.keys(DEFAULT_LISTS_).forEach(function (k) {
    if (lh.indexOf(k) >= 0) return;
    var c = ls.getLastColumn() + 1;
    ls.getRange(1, c).setValue(k).setBackground('#4e342e').setFontColor('#ffffff').setFontWeight('bold');
    var v = DEFAULT_LISTS_[k]; ls.getRange(2, c, v.length, 1).setValues(v.map(function (x) { return [x]; }));
    lh.push(k); addedL.push(k);
  });
  if (addedL.length) rep.push('قوائم جديدة: ' + addedL.join('، '));
  // مدير افتراضي إن لم يوجد أي موظف
  var emps = readTable_(T.EMP).rows;
  if (!emps.length) { appendRows_(T.EMP, [{ 'الكود': 'E00', 'الاسم': 'المدير', 'القسم': 'إدارة', 'الدور': 'مدير', 'الحالة': 'نشط', 'يجب_تغيير_PIN': 'نعم' }]); rep.push('أُضيف حساب المدير E00'); }
  // حد أدنى من فئات الطاقة
  if (!readTable_(T.CAP).rows.length) {
    appendRows_(T.CAP, DEFAULT_LISTS_['فئات_المنتجات'].map(function (c) { return { 'الفئة': c, 'فعال': 'نعم' }; })); rep.push('أُضيفت فئات الطاقة (حدّدها من الإعدادات)');
  }
  // بيانات أولية تُضاف مرة واحدة فقط (لا تُعاد بعد حذفك لها)
  var props = PropertiesService.getScriptProperties();
  if (!props.getProperty('SEED_12')) {
    if (!readTable_(T.PROC).rows.length) {
      appendRows_(T.PROC, DEFAULT_PROCS_.map(function (x, i) { return { 'الرقم': 'PC' + pad_(i + 1, 3), 'العنوان': x[0], 'المشكلة': x[1], 'الآلية_المقترحة': x[2], 'الحالة': x[3], 'تاريخ_التحديث': todayS_() }; }));
      props.setProperty('CNT_PROC', String(DEFAULT_PROCS_.length)); rep.push('أُضيفت 3 آليات مقترحة أولية');
    }
    if (!readTable_(T.GUIDE).rows.length) {
      appendRows_(T.GUIDE, DEFAULT_GUIDE_.map(function (x, i) { return { 'الرقم': 'G' + pad_(i + 1, 3), 'القسم': x[0], 'التصنيف': x[1], 'العنوان': x[2], 'النص': x[3], 'الترتيب': x[4] }; }));
      props.setProperty('CNT_GUIDE', String(DEFAULT_GUIDE_.length)); rep.push('أُضيف الدليل التشغيلي (مسودة قابلة للتعديل)');
    }
    var trows = readTable_(T.TASK).rows, haveT = {}; trows.forEach(function (r) { haveT[r['العنوان']] = true; });
    var addT = [];
    DEFAULT_TASKS_.forEach(function (x) {
      if (haveT[x[0]]) return;
      var id = nextId_('TASK', 'T', trows.concat(addT), 'الرقم', 3);
      addT.push({ 'الرقم': id, 'العنوان': x[0], 'القسم_المسؤول': x[1], 'الوقت': x[2], 'التكرار': 'يومي', 'الأيام': '', 'مدة_السماح_دقائق': 30, 'إلزامي': x[3], 'فعال': 'نعم', 'ملاحظات': '' });
    });
    if (addT.length) { appendRows_(T.TASK, addT); rep.push('أُضيفت ' + addT.length + ' قوالب مهام'); }
    props.setProperty('SEED_12', '1');
  }
  try { seed19_(rep); } catch (e) { rep.push('تعذرت البيانات الأولية 2.6: ' + e.message); }
  try { seed20_(rep); } catch (e) { rep.push('تعذرت إضافة أصناف الديلي: ' + e.message); }
  try { seed18_(rep); } catch (e) { rep.push('تعذرت البيانات الأولية 2.3: ' + e.message); }
  try { seed17_(rep); } catch (e) { rep.push('تعذرت البيانات الأولية 2.0: ' + e.message); }
  try { seed16_(rep); } catch (e) { rep.push('تعذرت البيانات الأولية 1.6: ' + e.message); }
  try { seed15_(rep); } catch (e) { rep.push('تعذرت البيانات الأولية 1.5: ' + e.message); }
  try { ensureOpenButton_(); } catch (e) { }
  [T.SET, T.PERM, T.CAP, T.EMP, T.PROD, T.SEASON, T.TASK, T.LISTS].forEach(bust_);
  return rep;
}

