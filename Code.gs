function runSelfTest_() {
  var res = [];
  function add(level, name, msg) { res.push({ level: level, name: name, msg: msg || '' }); }
  function t(name, fn) { try { fn(); } catch (e) { add('fail', name, 'استثناء: ' + e.message); } }
  var ss = ss_(), s = {};

  t('التبويبات والأعمدة', function () {
    var miss = [], cols = [];
    Object.keys(SCHEMA_).forEach(function (n) {
      var sh = ss.getSheetByName(n); if (!sh) { miss.push(n); return; }
      if (!SCHEMA_[n].length) return;
      var have = sh.getRange(1, 1, 1, Math.max(sh.getLastColumn(), 1)).getValues()[0].map(String);
      SCHEMA_[n].forEach(function (h) { if (have.indexOf(h) < 0) cols.push(n + '.' + h); });
    });
    if (miss.length) add('fail', 'التبويبات', 'ناقصة: ' + miss.join('، ') + ' — اضغط «إنشاء/تحديث النظام»');
    else add('ok', 'التبويبات', Object.keys(SCHEMA_).length + ' تبويب موجود');
    if (cols.length) add('fail', 'الأعمدة', 'ناقصة: ' + cols.join('، ') + ' — اضغط «تحديث النظام»'); else add('ok', 'الأعمدة', 'كل الأعمدة المطلوبة موجودة');
  });
  t('الإعدادات', function () {
    s = settingsMap_(); var m = DEFAULT_SETTINGS_.filter(function (d) { return !(d[0] in s); }).map(function (d) { return d[0]; });
    if (m.length) add('fail', 'مفاتيح الإعدادات', 'ناقصة: ' + m.join('، ')); else add('ok', 'مفاتيح الإعدادات', 'كاملة');
    var w = numS_(s['نسبة_تحذير_الطاقة'], 80), st = numS_(s['نسبة_إيقاف_الطلبات'], 100);
    if (w >= st) add('warn', 'نسب الطاقة', 'نسبة التحذير يجب أن تكون أقل من نسبة الإيقاف'); else add('ok', 'نسب الطاقة', 'تحذير ' + w + '% وإيقاف ' + st + '%');
    if (!s['بريد_تنبيهات_المدير']) add('warn', 'بريد التنبيهات', 'غير محدد: التنبيهات العاجلة لن تصل بالبريد');
    else add('ok', 'بريد التنبيهات', s['بريد_تنبيهات_المدير']);
  });
  t('المفتاح السري والمشغّلات', function () {
    var props = PropertiesService.getScriptProperties();
    add(props.getProperty('PEPPER') ? 'ok' : 'fail', 'المفتاح السري', props.getProperty('PEPPER') ? 'موجود' : 'غير موجود — شغّل «إنشاء النظام»');
    var fns = ScriptApp.getProjectTriggers().map(function (x) { return x.getHandlerFunction(); });
    ['alertCycle_', 'dailyJobs_'].forEach(function (f) { add(fns.indexOf(f) >= 0 ? 'ok' : 'fail', 'مشغّل ' + f, fns.indexOf(f) >= 0 ? 'مثبّت' : 'غير مثبّت'); });
    var dup = fns.length - fns.filter(function (f, i) { return fns.indexOf(f) === i; }).length;
    if (dup) add('warn', 'مشغّلات مكررة', dup + ' — شغّل «تحديث النظام» لتنظيفها');
  });
  t('نبض المشغّل', function () {
    var hb = s['آخر_تشغيل_ناجح'];
    if (!hb) { add('warn', 'نبض المشغّل', 'لم يعمل بعد (ينتظر أول دورة كل 15 دقيقة)'); return; }
    var age = (Date.now() - dtMs_(String(hb).slice(0, 10), String(hb).slice(11, 16))) / 60000;
    add(age <= 45 ? 'ok' : 'fail', 'نبض المشغّل', 'آخر تشغيل قبل ' + Math.round(age) + ' دقيقة');
  });
  t('الحسابات', function () {
    var emps = readTable_(T.EMP).rows, act = emps.filter(function (e) { return e['الحالة'] === 'نشط'; });
    var mgr = findBy_(emps, 'الكود', 'E00');
    add(mgr && mgr['PIN_Hash'] ? 'ok' : 'fail', 'حساب المدير', mgr ? (mgr['PIN_Hash'] ? 'مفعّل' : 'بلا رقم سري — شغّل setManagerPin') : 'غير موجود');
    var nopin = act.filter(function (e) { return !e['PIN_Hash']; }).map(function (e) { return e['الاسم']; });
    add(nopin.length ? 'warn' : 'ok', 'أرقام الموظفين السرية', nopin.length ? 'بلا رقم: ' + nopin.join('، ') : 'الكل مفعّل');
    var codes = {}, dups = []; emps.forEach(function (e) { if (codes[e['الكود']]) dups.push(e['الكود']); codes[e['الكود']] = 1; });
    add(dups.length ? 'fail' : 'ok', 'تكرار أكواد الموظفين', dups.length ? dups.join('، ') : 'لا يوجد');
    var badRole = emps.filter(function (e) { return ['موظف', 'مشرف', 'مدير'].indexOf(e['الدور']) < 0; }).map(function (e) { return e['الاسم']; });
    add(badRole.length ? 'fail' : 'ok', 'أدوار الموظفين', badRole.length ? 'دور غير صحيح: ' + badRole.join('، ') : 'سليمة');
  });
  t('الطاقة والمنتجات', function () {
    var caps = readTable_(T.CAP).rows.filter(function (r) { return r['فعال'] !== 'لا'; }), nolimit = caps.filter(function (r) { return r['الحد_اليومي'] === ''; }).map(function (r) { return r['الفئة']; });
    add(nolimit.length ? 'warn' : 'ok', 'حدود الطاقة', nolimit.length ? 'بلا حد (لن يُمنع الحجز): ' + nolimit.join('، ') : 'محددة لكل الفئات');
    var prods = readTable_(T.PROD).rows.filter(function (r) { return r['فعال'] !== 'لا'; });
    add(prods.length ? 'ok' : 'warn', 'المنتجات', prods.length ? prods.length + ' منتج فعّال' : 'لا توجد منتجات، أضفها من الإعدادات');
    var cats = caps.map(function (r) { return r['الفئة']; }), orphan = prods.filter(function (p) { return cats.indexOf(p['الفئة']) < 0; }).map(function (p) { return p['الاسم']; });
    add(orphan.length ? 'warn' : 'ok', 'ربط المنتجات بالفئات', orphan.length ? 'فئتها غير معرّفة في الطاقة: ' + orphan.join('، ') : 'كل منتج مربوط بفئة طاقة');
  });
  t('سلامة بيانات الحجوزات', function () {
    var inv = readTable_(T.INV).rows, items = readTable_(T.ITEM).rows, pays = readTable_(T.PAY).rows;
    var nos = {}, dups = []; inv.forEach(function (r) { if (nos[r['رقم_الفاتورة']]) dups.push(r['رقم_الفاتورة']); nos[r['رقم_الفاتورة']] = r; });
    add(dups.length ? 'fail' : 'ok', 'تكرار أرقام الفواتير', dups.length ? dups.join('، ') : 'لا يوجد');
    var orph = items.filter(function (i) { return !nos[i['رقم_الفاتورة']]; }).length;
    add(orph ? 'fail' : 'ok', 'بنود بلا فاتورة', orph ? orph + ' بند' : 'لا يوجد');
