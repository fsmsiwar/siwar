  rows.sort(function (a, b) { return String(b['تاريخ_الرفع']).localeCompare(String(a['تاريخ_الرفع'])); });
  return rows.map(function (r) { return { id: r['الرقم'], category: r['التصنيف'], title: r['العنوان'], note: r['ملاحظة'], name: r['اسم_الملف'], type: r['النوع'], sizeKb: r['الحجم_كب'], at: r['تاريخ_الرفع'], by: r['رفعه'] }; });
}

function efileUpload_(u, p) {
  return withLock_(function () {
    var emp = findBy_(tbl_(T.EMP).rows, 'الكود', p.emp); if (!emp) throw new Error('الموظف غير موجود');
    var name = String(p.name || '').replace(/[\\\/:*?"<>|]/g, '_').trim(); if (!name) throw new Error('اسم الملف مفقود');
    var ext = name.indexOf('.') >= 0 ? name.split('.').pop().toLowerCase() : '';
    if (!FILE_TYPES_[ext]) throw new Error('نوع الملف غير مسموح. المسموح: PDF والصور وExcel وWord وCSV');
    var data = String(p.data || ''); if (!data) throw new Error('الملف فارغ');
    var maxMb = numS_(settingsMap_()['حجم_الملف_الأقصى_ميجا'], 7), sizeBytes = Math.floor(data.length * 0.75);
    if (sizeBytes > maxMb * 1048576) throw new Error('حجم الملف أكبر من المسموح (' + maxMb + ' ميجا)');
    var blob = Utilities.newBlob(Utilities.base64Decode(data), FILE_TYPES_[ext], name);
    var f = empFolder_(emp).createFile(blob);
    var rows = readTable_(T.EFILE).rows, id = nextId_('EFILE', 'F', rows, 'الرقم', 5);
    appendRows_(T.EFILE, [{ 'الرقم': id, 'كود_الموظف': emp['الكود'], 'اسم_الموظف': emp['الاسم'], 'التصنيف': p.category || 'أخرى', 'العنوان': p.title || name, 'ملاحظة': p.note || '', 'اسم_الملف': name, 'النوع': ext, 'الحجم_كب': Math.round(sizeBytes / 1024), 'معرّف_Drive': f.getId(), 'تاريخ_الرفع': nowS_(), 'رفعه': u['الاسم'] }]);
    log_(u, 'ملفات الموظفين', 'رفع', id, '', emp['الاسم'] + ' — ' + (p.category || '') + ' — ' + name, '');
