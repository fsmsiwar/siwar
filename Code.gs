/* ====================== الجرد النقدي ====================== */

function cashPreview_(date) {
  var s = settingsMap_(), bk = 0, rf = 0;
  readTable_(T.PAY).rows.forEach(function (r) {
    if (String(r['التاريخ']) !== date || r['الطريقة'] !== 'كاش') return;
    if (r['النوع'] === 'استرداد') rf += num_(r['المبلغ']); else bk += num_(r['المبلغ']);
  });
  var closed = findBy_(readTable_(T.CASH).rows, 'التاريخ', date);
  return { date: date, bookingCash: bk, refundCash: rf, depositsInPos: s['دفعات_الحجوزات_ضمن_تقرير_POS'] === 'نعم', maxDiff: numS_(s['حد_فرق_الكاش_المسموح'], 5), closed: closed || null };
}

function cashClose_(u, p) {
  return withLock_(function () {
    var date = p.date || todayS_(), pv = cashPreview_(date), s = settingsMap_();
    if (pv.closed && !can_(u, 'تعديل_جرد_مقفل')) throw new Error('هذا اليوم مقفل ولا يمكن تعديله');
    var start = num_(p.start), posCash = num_(p.posCash), petty = num_(p.petty);
    if (p.actual === '' || p.actual === undefined || isNaN(parseFloat(p.actual))) throw new Error('أدخل الكاش الفعلي المعدود');
    var actual = num_(p.actual);
    var expected = start + posCash + (pv.depositsInPos ? 0 : pv.bookingCash) - pv.refundCash - petty;
    var diff = Math.round((actual - expected) * 100) / 100, st = diff === 0 ? 'مطابق' : Math.abs(diff) <= pv.maxDiff ? 'ضمن الحد' : 'فرق مرتفع';
    var row = {
      'التاريخ': date, 'بداية_الصندوق': start, 'كاش_POS': posCash, 'شبكة_POS': num_(p.posCard), 'تحويل_POS': num_(p.posTransfer),
      'دفعات_كاش_الحجوزات': pv.bookingCash, 'استرداد_كاش': pv.refundCash, 'مصروفات_نثرية': petty, 'كاش_متوقع': expected,
      'كاش_فعلي': actual, 'الفرق': diff, 'حالة_الفرق': st, 'أغلق_بواسطة': u['الاسم'], 'وقت_الإغلاق': nowS_(), 'مقفل': 'نعم', 'ملاحظات': p.notes || '', 'عدد_فواتير_POS': (p.posInvoices === '' || p.posInvoices === undefined || isNaN(parseFloat(p.posInvoices))) ? '' : parseFloat(p.posInvoices)
    };
    if (pv.closed) {
      var patch = {}; Object.keys(row).forEach(function (k) { if (k !== 'التاريخ') patch[k] = row[k]; });
      updateRowCells_(T.CASH, pv.closed.__row, patch);
      log_(u, 'الجرد', 'تعديل جرد مقفل', date, pv.closed['كاش_فعلي'], actual, p.reason || '');
    } else {
      appendRows_(T.CASH, [row]);
      log_(u, 'الجرد', 'إقفال', date, '', actual, '');
    }
    if (st === 'فرق مرتفع') addAlert_('نقد', 'فرق مرتفع في جرد ' + date + ': ' + diff + ' ريال', 'عاجل', 'cash:diff:' + date);
    return { expected: expected, diff: diff, status: st };
  });
}

function cashList_(u, p) {
