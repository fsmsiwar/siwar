function saveDeployUrl_(u, p) {
  var url = String(p.url || '').trim(), auto = false;
  if (!url) { try { url = ScriptApp.getService().getUrl() || ''; auto = true; } catch (e) { url = ''; } }
  if (!/^https:\/\/script\.google\.com\/(a\/[^\/]+\/)?macros\/s\/[A-Za-z0-9_-]+\/exec$/.test(url)) throw new Error(auto ? 'تعذر اكتشاف الرابط تلقائياً، الصقه يدوياً (ينتهي بـ exec)' : 'الرابط غير صحيح. يجب أن يبدأ بـ https://script.google.com/macros/s/ وينتهي بـ /exec');
  var row = findBy_(readTable_(T.SET).rows, 'المفتاح', 'رابط_التطبيق');
  if (row) updateRowCells_(T.SET, row.__row, { 'القيمة': url });
  else appendRows_(T.SET, [{ 'المفتاح': 'رابط_التطبيق', 'القيمة': url, 'الوصف': 'رابط نشر التطبيق', 'النوع': 'نص', 'المجموعة': 'النظام' }]);
  bust_(T.SET); log_(u, 'النظام', 'حفظ رابط النشر', '', '', url, '');
  return { url: url, auto: auto };
}
