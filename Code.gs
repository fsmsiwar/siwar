    var st = diff === 0 ? 'مطابق' : diff < 0 ? 'نقص' : 'زيادة';
    var handled = diff === 0 || Math.abs(diff) <= lim ? 'معالج' : 'مفتوح';
    if (diff !== 0 && handled === 'مفتوح' && !p.reason) { /* يُقبل بدون سبب ويبقى مفتوحاً */ }
    updateRowCells_(T.SUP, r.__row, { 'الكمية_المستلمة': received, 'الفرق': diff, 'حالة_المطابقة': st, 'استلمها': u['الاسم'], 'سبب_الفرق': p.reason || r['سبب_الفرق'], 'حالة_المعالجة': handled });
    if (handled === 'مفتوح') addAlert_('استلام', 'فرق توريد ' + st + ' في ' + r['اسم_المنتج'] + ' (' + r['رقم_الشحنة'] + '): ' + diff, 'تحذير', 'sup:' + r['رقم_الشحنة'] + ':' + r['كود_المنتج'] + ':' + diff);
    return { received: received, diff: diff, status: st, handling: handled };
  });
}

