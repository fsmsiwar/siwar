/** يضيف الكمية المستلمة تراكمياً (يدعم الاستلام على دفعتين) ويعيد حساب المطابقة. */
function supplyReceive_(u, p) {
  return withLock_(function () {
    var r = null; readTable_(T.SUP).rows.forEach(function (x) { if (String(x['رقم_الشحنة']) === String(p.shipment) && String(x['كود_المنتج']) === String(p.code)) r = x; });
    if (!r) throw new Error('الصنف غير موجود في الشحنة');
    var add = num_(p.qty); if (add < 0 || p.qty === '' || isNaN(parseFloat(p.qty))) throw new Error('كمية غير صحيحة');
    var received = (r['الكمية_المستلمة'] === '' ? 0 : num_(r['الكمية_المستلمة'])) + add, sent = num_(r['الكمية_المرسلة']);
    var diff = received - sent, pr = findBy_(tbl_(T.PROD).rows, 'الكود', r['كود_المنتج']), s = settingsMap_();
