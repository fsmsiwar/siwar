  var head = sh.getRange(1, 1, 1, lc).getValues()[0].map(String);
  var rows = [];
  if (lr >= 2) {
    var vals = sh.getRange(2, 1, lr - 1, lc).getValues();
    for (var i = 0; i < vals.length; i++) {
      var r = {}, any = false;
      for (var j = 0; j < lc; j++) { var v = norm_(vals[i][j]); r[head[j]] = v; if (v !== '') any = true; }
