/** v3.4: واجهة API لنشر الواجهة على استضافة خارجية سريعة (GitHub Pages). تقبل 3 دوال فقط. */
function doPost(e) {
  var out;
  try {
    var b = JSON.parse((e && e.postData && e.postData.contents) || '{}'), a = b.args || [];
    if (b.fn === 'api') out = { r: api(a[0], a[1], a[2]) };
    else if (b.fn === 'login') out = { r: login(a[0], a[1], a[2]) };
    else if (b.fn === 'listLoginUsers') out = { r: listLoginUsers() };
    else throw new Error('طلب غير مسموح');
  } catch (err) { out = { __err: String(err && err.message || err) }; }
  return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
}

function doGet() {
  return HtmlService.createHtmlOutputFromFile('Index')
    .setTitle('إدارة المعرض')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/* ====================== التثبيت (يُشغَّل من المحرر مرة واحدة) ====================== */

/**
 * إنشاء النظام: يُنشئ أي تبويب ناقص بعناوينه، ويضيف الإعدادات والصلاحيات الافتراضية الناقصة فقط،
 * ويولّد المفتاح السري إن لم يوجد، ويثبّت المشغّلات. آمن للتكرار ولا يحذف ولا يستبدل أي بيانات.
 */
function installSystem() {
  var props = PropertiesService.getScriptProperties();
  var rep = ensureSchema_();
  if (!props.getProperty('PEPPER')) props.setProperty('PEPPER', Utilities.getUuid() + Utilities.getUuid() + Utilities.getUuid());
  installTriggers_();
  props.setProperty('INSTALLED', '1');
  return 'تم إنشاء النظام. ' + (rep.length ? rep.join(' | ') : 'كل التبويبات موجودة مسبقاً.') + ' الخطوة التالية: من قائمة «نظام سوار» اختر «تعيين / تغيير رقم سري» لحسابك ثم انشر التطبيق.';
}

/**
 * تحديث النظام بدون حذف البيانات: نسخة احتياطية أولاً، ثم إضافة التبويبات والأعمدة والإعدادات والصلاحيات
 * الجديدة فقط، وإعادة تثبيت المشغّلات. لا يمس الصفوف الموجودة ولا الأرقام السرية.
 */
function updateSystem() {
  var out = [];
  try { backupNow_('قبل-التحديث'); out.push('نسخة احتياطية: تمت'); } catch (e) { out.push('تعذرت النسخة الاحتياطية: ' + e.message); }
  var before = rowCounts_();
  var rep = ensureSchema_();
  installTriggers_();
  PropertiesService.getScriptProperties().setProperty('INSTALLED', '1');
  var after = rowCounts_(), lost = [];
  Object.keys(before).forEach(function (k) { if ((after[k] || 0) < before[k]) lost.push(k + ' (' + before[k] + ' → ' + (after[k] || 0) + ')'); });
  out.push(lost.length ? 'تحذير: نقص في عدد الصفوف: ' + lost.join('، ') + ' — استرجع من النسخة الاحتياطية' : 'فحص سلامة البيانات: لم يُفقد أي صف (' + Object.keys(after).length + ' تبويب)');
  var ver = SYSTEM_VERSION_;
  updateWhere_(T.SET, function (r) { return r['المفتاح'] === 'إصدار_النظام'; }, { 'القيمة': ver }); bust_(T.SET);
  out = out.concat(rep.length ? rep : ['لا توجد تغييرات في البنية، النظام محدّث']);
  out.push('الإصدار الحالي ' + ver);
  return out;
}

var SYSTEM_VERSION_ = '4.3';

function backupNow_(label) {
  var file = DriveApp.getFileById(SHEET_ID), parent = file.getParents().hasNext() ? file.getParents().next() : DriveApp.getRootFolder();
  var it = parent.getFoldersByName('نسخ_احتياطية_سوار'), folder = it.hasNext() ? it.next() : parent.createFolder('نسخ_احتياطية_سوار');
  var cp = file.makeCopy('نسخة ' + (label || '') + ' ' + nowS_() + ' — ' + file.getName(), folder);
  PropertiesService.getScriptProperties().setProperty('BACKUP_LAST', JSON.stringify({ at: nowS_(), name: cp.getName(), url: cp.getUrl(), by: label || '' }));
  return cp;
}

/* قائمة داخل الشيت: تظهر عند فتحه */
function onOpen() {
  try {
    SpreadsheetApp.getUi().createMenu('نظام سوار')
      .addItem('فتح النظام', 'openApp_')
      .addSeparator()
      .addItem('إنشاء النظام', 'menuInstall_')
      .addItem('تحديث النظام (بدون حذف البيانات)', 'menuUpdate_')
      .addItem('فحص واختبار النظام', 'menuCheck_')
      .addItem('حفظ رابط النشر', 'menuUrl_')
      .addSeparator()
      .addItem('تعيين / تغيير رقم سري (لي أو لموظف)', 'menuPin_')
      .addToUi();
  } catch (e) { }
}
/** يفتح التطبيق في تبويب جديد من داخل الشيت (من القائمة أو من زر لوحة القيادة). */
function openApp_() {
  var url = '';
  try { var r = findBy_(readTable_(T.SET).rows, 'المفتاح', 'رابط_التطبيق'); url = r ? String(r['القيمة'] || '') : ''; } catch (e) { }
  if (!url) { try { url = ScriptApp.getService().getUrl() || ''; } catch (e2) { } }
  var ui = SpreadsheetApp.getUi();
  if (!/^https:\/\/script\.google\.com\//.test(url)) { ui.alert('لم يُحفظ رابط التطبيق بعد. من القائمة اختر «حفظ رابط النشر» أولاً.'); return; }
  var safe = url.replace(/"/g, '&quot;');
  var html = HtmlService.createHtmlOutput('<div dir="rtl" style="font-family:Tahoma,Arial;text-align:center;padding:18px">' +
    '<p>جارٍ فتح النظام…</p><p><a id="a" href="' + safe + '" target="_blank" style="display:inline-block;background:#4e342e;color:#fff;text-decoration:none;padding:12px 28px;border-radius:8px;font-size:16px">فتح النظام</a></p>' +
    '<p style="color:#777;font-size:12px">إذا لم يُفتح تلقائياً اضغط الزر.</p>' +
    '<script>window.open("' + safe + '","_blank");google.script.host.close();<\/script></div>').setWidth(320).setHeight(190);
  ui.showModalDialog(html, 'إدارة المعرض');
}

/** يضع زر «فتح النظام» (رابط مرتبط بالإعدادات) في لوحة القيادة. */
function ensureOpenButton_() {
  var sh = ss_().getSheetByName('لوحة_القيادة'); if (!sh) return;
  var c = sh.getRange('I1');
  if (c.getFormula()) return;
  c.setFormula('=HYPERLINK(IFERROR(INDEX(الإعدادات!B:B,MATCH("رابط_التطبيق",الإعدادات!A:A,0)),""),"فتح النظام ←")')
    .setBackground('#b8863b').setFontColor('#ffffff').setFontWeight('bold').setFontSize(13).setHorizontalAlignment('center').setVerticalAlignment('middle');
  sh.setColumnWidth(9, 170);
}

function menuInstall_() { SpreadsheetApp.getUi().alert(installSystem()); }
function menuUpdate_() {
  var ui = SpreadsheetApp.getUi();
  if (ui.alert('سيُنشأ نسخة احتياطية ثم تُضاف العناصر الناقصة فقط، ولا تُحذف بياناتك. متابعة؟', ui.ButtonSet.YES_NO) !== ui.Button.YES) return;
  ui.alert(updateSystem().join('\n'));
}
function menuPin_() {
  var ui = SpreadsheetApp.getUi();
  var a = ui.prompt('تعيين رقم سري', 'كود الموظف (اتركه E00 لحسابك كمدير):', ui.ButtonSet.OK_CANCEL);
  if (a.getSelectedButton() !== ui.Button.OK) return;
  var code = (a.getResponseText() || 'E00').trim() || 'E00';
  var b = ui.prompt('الرقم السري الجديد', 'أدخل 4 أو 6 أرقام:', ui.ButtonSet.OK_CANCEL);
  if (b.getSelectedButton() !== ui.Button.OK) return;
  try { ui.alert(setPinByOwner_(code, b.getResponseText(), code !== 'E00')); } catch (e) { ui.alert(e.message); }
}
function menuUrl_() {
  var ui = SpreadsheetApp.getUi(), r = ui.prompt('رابط النشر', 'الصق رابط تطبيق الويب (ينتهي بـ exec):', ui.ButtonSet.OK_CANCEL);
  if (r.getSelectedButton() !== ui.Button.OK) return;
  try { ui.alert('تم حفظ الرابط:\n' + saveDeployUrl_({ 'الاسم': 'قائمة الشيت' }, { url: r.getResponseText() }).url); } catch (e) { ui.alert(e.message); }
}
function menuCheck_() {
  var r = runSelfTest_(), bad = r.filter(function (x) { return x.level === 'fail'; }).length, warn = r.filter(function (x) { return x.level === 'warn'; }).length;
  var txt = r.map(function (x) { return (x.level === 'ok' ? '✔ ' : x.level === 'warn' ? '⚠ ' : '✘ ') + x.name + (x.msg ? ' — ' + x.msg : ''); }).join('\n');
  SpreadsheetApp.getUi().alert('نتيجة الفحص: ' + bad + ' أخطاء، ' + warn + ' تحذيرات\n\n' + txt);
}

