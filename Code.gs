  var catList = Object.keys(cats).map(function (k) { return { name: k, amt: r2_(cats[k].amt), qty: r2_(cats[k].qty), share: base ? r2_((byAmt ? cats[k].amt : cats[k].qty) / base * 100) : 0 }; }).sort(function (a, b) { return b.share - a.share; });
